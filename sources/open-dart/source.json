{
  "spec": "SourceSpec/1",
  "id": "open-dart",
  "version": "0.2.0",
  "vendor": "open-dart",
  "caveat": "OpenDART's own endpoints, relayed unread. A filing becomes public at its receipt, which `rcept_no` and `rcept_dt` both carry; dropping rows later than `asOf` is the caller's work, as nothing here is bounded by it. A period end is not a disclosure date, and a preliminary announcement and the report restating it are two receipts, told apart by `report_nm` and `pblntf_ty`. `corpCode.xml` and `document.xml` answer with a ZIP the host unpacks; the latter's members are named per request and arrive as `{members:[{name,text}]}`. The key rides as `crtfc_key`, unseen. Errors arrive as `status` on a 200.",
  "hosts": [
    "opendart.fss.or.kr"
  ],
  "headers": {
    "accept": "application/json"
  },
  "credentials": [
    {
      "name": "api-key",
      "inject": {
        "location": "query",
        "name": "crtfc_key"
      },
      "required": true
    }
  ],
  "endpoints": [
    {
      "host": "opendart.fss.or.kr",
      "path": "/api/corpCode.xml",
      "query": []
    },
    {
      "host": "opendart.fss.or.kr",
      "path": "/api/company.json",
      "query": [
        "corp_code"
      ]
    },
    {
      "host": "opendart.fss.or.kr",
      "path": "/api/list.json",
      "query": [
        "corp_code",
        "bgn_de",
        "end_de",
        "last_reprt_at",
        "pblntf_ty",
        "pblntf_detail_ty",
        "corp_cls",
        "sort",
        "sort_mth",
        "page_no",
        "page_count"
      ]
    },
    {
      "host": "opendart.fss.or.kr",
      "path": "/api/fnlttSinglAcntAll.json",
      "query": [
        "corp_code",
        "bsns_year",
        "reprt_code",
        "fs_div"
      ]
    },
    {
      "host": "opendart.fss.or.kr",
      "path": "/api/fnlttSinglAcnt.json",
      "query": [
        "corp_code",
        "bsns_year",
        "reprt_code"
      ]
    },
    {
      "host": "opendart.fss.or.kr",
      "path": "/api/document.xml",
      "query": [
        "rcept_no"
      ]
    }
  ]
}
